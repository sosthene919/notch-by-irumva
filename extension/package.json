{
  "name": "notch-bridge",
  "displayName": "Notch Bridge",
  "description": "Streams diagnostics, tasks, tests, debug state and git changes from VS Code or Antigravity IDE to Notch by IRUMVA.",
  "version": "0.1.0",
  "publisher": "IRUMVA",
  "license": "MIT",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "notchBridge.pair", "title": "Notch Bridge: Pair with Notch" },
      { "command": "notchBridge.publishStatus", "title": "Notch Bridge: Publish workspace status now" },
      { "command": "notchBridge.requestApproval", "title": "Notch Bridge: Request approval in Notch (test)" },
      { "command": "notchBridge.proposeReview", "title": "Notch Bridge: Propose current changes for review in Notch" }
    ]
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node --test out/protocol.test.js",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.7.2"
  }
}
