{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notch by IRUMVA",
  "mainBinaryName": "notch",
  "version": "1.2.6",
  "identifier": "com.irumva.notch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Notch by IRUMVA",
        "width": 472,
        "height": 260,
        "x": 0,
        "y": 0,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false,
        "visible": true
      },
      {
        "label": "settings",
        "title": "Notch by IRUMVA — Settings",
        "url": "index.html#/security",
        "width": 920,
        "height": 640,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": true,
        "focus": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Iwasaki Softwares",
    "copyright": "Copyright (c) 2026 IRUMVA Sosthene. Iwasaki Softwares. Created by IRUMVA Sosthene. Built with Muse AI and Claude Sonnet.",
    "licenseFile": "../../installer/TERMS_AND_CONDITIONS.txt",
    "category": "Utility",
    "shortDescription": "A Dynamic Island for Windows 11",
    "longDescription": "Notch by IRUMVA shows live activities — media, timers, battery, volume and privacy indicators — in a pill at the top of your screen. Expanded views auto-hide 5 seconds after your last interaction. No network, no servers.",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "windows/installer-sidebar.bmp",
        "headerImage": "windows/installer-header.bmp",
        "installerHooks": "./windows/hooks.nsh",
        "displayLanguageSelector": false
      }
    }
  }
}

